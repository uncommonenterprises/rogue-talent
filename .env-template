# Environment variables for the client app.
# Note that variables, that start with "REACT_APP" prefix, are exposed to the public web.
# https://create-react-app.dev/docs/adding-custom-environment-variables

# Mandatory configuration
#
# Note: You also need to set Stripe secret key in Sharetribe Console.
#
REACT_APP_SHARETRIBE_SDK_CLIENT_ID=change-me
REACT_APP_STRIPE_PUBLISHABLE_KEY=
REACT_APP_MAPBOX_ACCESS_TOKEN=

# If you are using a process with privileged transitions,
# Client Secret needs to be set too. The one related to Client ID.
# You get this at Sharetribe Console (Build -> Applications -> Add new).
SHARETRIBE_SDK_CLIENT_SECRET=

# Or set up an alternative map provider (Google Maps). Check documentation.
# REACT_APP_GOOGLE_MAPS_API_KEY=

# Defaults
#

# Host/domain - don't use trailing slash: "/"
REACT_APP_MARKETPLACE_ROOT_URL=http://localhost:3000

# Marketplace name
# If not set, this defaults to 'Biketribe' in src/config/configDefault.js
REACT_APP_MARKETPLACE_NAME=

# Social logins && SSO
# If the app or client id is not set the auhtentication option is not shown in the Template
REACT_APP_FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

REACT_APP_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This is overwritten by configuration in .env.development and
# .env.test. In production deployments use env variable and set it to
# 'production'
REACT_APP_ENV=production


# CSP. You can use value 'report' or 'block'.
# If the env varibale is missing, csp is disabled.
REACT_APP_CSP=report

# Options. Uncomment and set to test.
#

# REACT_APP_SHARETRIBE_USING_SSL=true
# SERVER_SHARETRIBE_TRUST_PROXY=true
# REACT_APP_SENTRY_DSN=change-me
# BASIC_AUTH_USERNAME=sharetribe
# BASIC_AUTH_PASSWORD=secret

# This is GA4 id, which should start with 'G-' prefix.
# You should also turn "Enhanced measurements" off from GA.
# https://support.google.com/analytics/answer/9216061
# REACT_APP_GOOGLE_ANALYTICS_ID=change-me

# This adds data-domains for Plausible script
# If you add this environment variable, you should have created an account in plausible.io
# You can add multiple domains separated by comma. 
# E.g. REACT_APP_PLAUSIBLE_DOMAINS=example1.com,example2.com
# REACT_APP_PLAUSIBLE_DOMAINS=my.marketplace.com

# Cache configuration for the proxied SDK calls. 0 means no caching.
# This is applied to the asset endpoints only, and by default:
# - assets by version is cached for 1 day
# - asset by alias is not cached by default (because it would add an extra buffer before changes to marketplace config are applied)
# TTL=60
# TTL_ASSETS_BY_VERSION=86400

# Debugging and reducing load from server
# VERBOSE=true
# PREVENT_DATA_LOADING_IN_SSR=true

# Sharetribe Integration API credentials (server-side / ops scripts only — never
# exposed to the client). Used by scripts/ops/* and, if set, by the SAF-29 safety
# reporting endpoint (server/api/safety-report.js) to persist a durable per-user
# report record. Optional: the endpoint degrades to structured logging if unset.
# SHARETRIBE_INTEGRATION_CLIENT_ID=change-me
# SHARETRIBE_INTEGRATION_CLIENT_SECRET=change-me

# SAF-03 — Client identity verification via Stripe Identity (server-side only —
# never exposed to the client, never committed; TEST-mode Stripe while on
# ndstealth1-test). The feature is INACTIVE and fail-safe until these are set:
# create-session returns 503, the webhook refuses unsigned calls, and the booking
# gate fails OPEN (never blocks bookings). See server/api-util/stripeIdentity.js.
#   STRIPE_SECRET_KEY               platform Stripe secret key (sk_test_...), used to
#                                   create Identity VerificationSessions.
#   STRIPE_IDENTITY_WEBHOOK_SECRET  signing secret (whsec_...) for the webhook endpoint
#                                   POST /api/stripe-identity-webhook (register it in
#                                   the Stripe Dashboard; also enable Stripe Identity).
#   (result write-back reuses SHARETRIBE_INTEGRATION_CLIENT_ID/SECRET above.)
# STRIPE_SECRET_KEY=change-me
# STRIPE_IDENTITY_WEBHOOK_SECRET=change-me
#
# Non-secret client-visible switch for the PROACTIVE listing/checkout redirect UX.
# Flip to 'true' ALONGSIDE the server keys above. When unset, the checkout error +
# link still work, but clients are not proactively bounced to /verify-identity, so
# bookings are never blocked on the test env before provisioning.
# REACT_APP_IDENTITY_VERIFICATION_ENABLED=true

# Account-status Step 2 — onboarding rewire + Verified-only visibility (SAFETY-CRITICAL).
# Two independent switches; the server reconcile gates on the Integration creds above.
#
# 1) Client-visible flow flag. DEFAULT OFF = today's exact behaviour (the RT-01
#    "Stripe before submit" modal gate stays; CTA keeps its current wording). Only when
#    'true' does the new flow activate: "Submit for approval" publishes the draft WITHOUT
#    Stripe (→ pendingApproval when listing-approval is ON in Console) and the reconcile
#    function owns when the listing becomes visible (published <=> Verified). The model
#    dashboard also pings the own-session reconcile when this is on.
#    ⚠️ CUTOVER PRECONDITIONS before flipping ON (all must be true):
#      (a) listing-approval turned ON in the Sharetribe Console;
#      (b) reconcile live (SHARETRIBE_INTEGRATION_CLIENT_ID/SECRET set above);
#      (c) the Connect webhook registered + STRIPE_CONNECT_WEBHOOK_SECRET set below.
# REACT_APP_ACCOUNT_STATUS_FLOW_ENABLED=true
#
# 2) Stripe Connect account.updated webhook signing secret (server-side only, TEST mode).
#    Signing secret (whsec_...) for POST /api/stripe-connect-webhook — register the endpoint
#    in the Stripe Dashboard (platform account) subscribed to `account.updated`. Absent →
#    that webhook refuses every call; the own-session reconcile + booking gate still work.
#    (Reconcile listing writes reuse SHARETRIBE_INTEGRATION_CLIENT_ID/SECRET above.)
# STRIPE_CONNECT_WEBHOOK_SECRET=change-me
