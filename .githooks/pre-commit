#!/usr/bin/env bash
#
# Rogue Talent secret-blocking pre-commit hook.
# Blocks any commit whose STAGED changes introduce something that looks like a
# real credential. Committed to the repo and wired via `core.hooksPath .githooks`
# so every clone gets it — see README / CLAUDE.md.
#
# Escape hatch (use only when you are certain a match is a false positive):
#   git commit --no-verify
#
set -euo pipefail

# High-signal patterns. Deliberately specific to keep false positives low.
# Extended-regex, matched against the staged diff's ADDED lines only.
PATTERNS=(
  'GOCSPX-[0-9A-Za-z_-]{20,}'                       # Google OAuth client secret
  '[0-9]+-[0-9a-z]{20,}\.apps\.googleusercontent\.com' # Google OAuth client id
  'AIza[0-9A-Za-z_-]{35}'                           # Google API key (Maps etc.)
  'sk_live_[0-9A-Za-z]{20,}'                        # Stripe live secret
  'sk_test_[0-9A-Za-z]{20,}'                        # Stripe test secret
  'rk_(live|test)_[0-9A-Za-z]{20,}'                 # Stripe restricted key
  'whsec_[0-9A-Za-z]{20,}'                          # Stripe webhook secret
  'AC[0-9a-f]{32}'                                  # Twilio Account SID
  'SK[0-9a-f]{32}'                                  # Twilio API key SID
  'ghp_[0-9A-Za-z]{36}'                             # GitHub PAT (classic)
  'gh[ousr]_[0-9A-Za-z]{36}'                        # GitHub OAuth/app tokens
  'github_pat_[0-9A-Za-z_]{50,}'                    # GitHub fine-grained PAT
  'xox[baprs]-[0-9A-Za-z-]{10,}'                    # Slack token
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'             # PEM private key
  '(client_secret|api[_-]?secret|auth[_-]?token|private[_-]?key)[":= ]+[0-9A-Za-z/+_-]{24,}' # generic assignment
)

# Files exempted from scanning: this hook itself and the doc that lists the
# leaked-value shape for humans. Add paths here only with good reason.
EXEMPT_REGEX='^(\.githooks/pre-commit|docs/security-.*\.md)$'

staged_files="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$staged_files" ] && exit 0

hits=""
while IFS= read -r file; do
  [ -z "$file" ] && continue
  echo "$file" | grep -qE "$EXEMPT_REGEX" && continue
  # only the added lines (leading '+'), excluding the diff header '+++'
  added="$(git diff --cached -U0 -- "$file" | grep -E '^\+' | grep -vE '^\+\+\+' || true)"
  [ -z "$added" ] && continue
  for pat in "${PATTERNS[@]}"; do
    match="$(printf '%s\n' "$added" | grep -oiE -e "$pat" || true)"
    if [ -n "$match" ]; then
      hits+="  $file → ${match%%$'\n'*}"$'\n'
    fi
  done
done <<< "$staged_files"

if [ -n "$hits" ]; then
  echo "" >&2
  echo "✖ COMMIT BLOCKED — possible secret(s) in staged changes:" >&2
  echo "" >&2
  printf '%s' "$hits" >&2
  echo "" >&2
  echo "If this is a real credential: remove it, put it in .env / Railway, and re-stage." >&2
  echo "If it is genuinely a false positive: git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi

exit 0
