{:format :v3,
 :transitions
 [{:name :transition/inquire,
   :actor :actor.role/customer,
   :actions [{:name :action/update-protected-data}],
   :to :state/inquiry}
  {:name :transition/request-payment,
   :actor :actor.role/customer,
   :actions
   [{:name :action/update-protected-data}
    {:name :action/create-pending-booking, :config {:type :time}}
    {:name :action/privileged-set-line-items}
    {:name :action/stripe-create-payment-intent}],
   :to :state/pending-payment,
   :privileged? true}
  {:name :transition/request-payment-after-inquiry,
   :actor :actor.role/customer,
   :actions
   [{:name :action/update-protected-data}
    {:name :action/create-pending-booking, :config {:type :time}}
    {:name :action/privileged-set-line-items}
    {:name :action/stripe-create-payment-intent}],
   :from :state/inquiry,
   :to :state/pending-payment,
   :privileged? true}
  {:name :transition/expire-payment,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/first-entered-state :state/pending-payment]}
     {:fn/period ["PT15M"]}]},
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/decline-booking}],
   :from :state/pending-payment,
   :to :state/payment-expired}
  {:name :transition/confirm-payment,
   :actor :actor.role/customer,
   :actions [{:name :action/stripe-confirm-payment-intent}],
   :from :state/pending-payment,
   :to :state/preauthorized}
  {:name :transition/accept,
   :actor :actor.role/provider,
   :actions
   [{:name :action/accept-booking}
    {:name :action/stripe-capture-payment-intent}],
   :from :state/preauthorized,
   :to :state/accepted}
  {:name :transition/operator-accept,
   :actor :actor.role/operator,
   :actions
   [{:name :action/accept-booking}
    {:name :action/stripe-capture-payment-intent}],
   :from :state/preauthorized,
   :to :state/accepted}
  {:name :transition/decline,
   :actor :actor.role/provider,
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/decline-booking}],
   :from :state/preauthorized,
   :to :state/declined}
  {:name :transition/operator-decline,
   :actor :actor.role/operator,
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/decline-booking}],
   :from :state/preauthorized,
   :to :state/declined}
  {:name :transition/expire,
   :at
   {:fn/min
    [{:fn/plus
      [{:fn/timepoint [:time/first-entered-state :state/preauthorized]}
       {:fn/period ["PT48H"]}]}
     {:fn/timepoint [:time/booking-start]}]},
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/decline-booking}],
   :from :state/preauthorized,
   :to :state/expired}
  {:name :transition/enter-late,
   :at
   {:fn/minus
    [{:fn/timepoint [:time/booking-start]} {:fn/period ["PT48H"]}]},
   :actions [],
   :from :state/accepted,
   :to :state/accepted-late}
  {:name :transition/customer-cancel,
   :actor :actor.role/customer,
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/cancel-booking}],
   :from :state/accepted,
   :to :state/cancelled}
  {:name :transition/customer-cancel-late,
   :actor :actor.role/customer,
   :actions [{:name :action/cancel-booking}],
   :from :state/accepted-late,
   :to :state/cancelled-charged}
  {:name :transition/provider-cancel,
   :actor :actor.role/provider,
   :actions
   [{:name :action/update-protected-data}
    {:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/cancel-booking}],
   :from :state/accepted,
   :to :state/cancelled}
  {:name :transition/provider-cancel-late,
   :actor :actor.role/provider,
   :actions
   [{:name :action/update-protected-data}
    {:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/cancel-booking}],
   :from :state/accepted-late,
   :to :state/cancelled}
  {:name :transition/operator-cancel,
   :actor :actor.role/operator,
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/cancel-booking}],
   :from :state/accepted,
   :to :state/cancelled}
  {:name :transition/operator-cancel-late,
   :actor :actor.role/operator,
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/cancel-booking}],
   :from :state/accepted-late,
   :to :state/cancelled}
  {:name :transition/complete,
   :at {:fn/timepoint [:time/booking-end]},
   :actions [],
   :from :state/accepted,
   :to :state/completed}
  {:name :transition/complete-late,
   :at {:fn/timepoint [:time/booking-end]},
   :actions [],
   :from :state/accepted-late,
   :to :state/completed}
  {:name :transition/auto-payout,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/booking-end]} {:fn/period ["P5D"]}]},
   :actions [{:name :action/stripe-create-payout}],
   :from :state/completed,
   :to :state/delivered}
  {:name :transition/operator-complete,
   :actor :actor.role/operator,
   :actions [{:name :action/stripe-create-payout}],
   :from :state/completed,
   :to :state/delivered}
  {:name :transition/dispute,
   :actor :actor.role/customer,
   :actions [{:name :action/update-protected-data}],
   :from :state/completed,
   :to :state/disputed-hold}
  {:name :transition/operator-dispute-refund,
   :actor :actor.role/operator,
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/cancel-booking}],
   :from :state/completed,
   :to :state/refunded-dispute}
  {:name :transition/operator-dispute-hold,
   :actor :actor.role/operator,
   :actions [],
   :from :state/completed,
   :to :state/disputed-hold}
  {:name :transition/operator-hold-refund,
   :actor :actor.role/operator,
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/cancel-booking}],
   :from :state/disputed-hold,
   :to :state/refunded-dispute}
  {:name :transition/operator-hold-release,
   :actor :actor.role/operator,
   :actions [{:name :action/stripe-create-payout}],
   :from :state/disputed-hold,
   :to :state/delivered}
  {:name :transition/operator-cancel-charged,
   :actor :actor.role/operator,
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/cancel-booking}],
   :from :state/cancelled-charged,
   :to :state/refunded-dispute}
  {:name :transition/payout-cancelled-charged,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/booking-end]} {:fn/period ["P5D"]}]},
   :actions [{:name :action/stripe-create-payout}],
   :from :state/cancelled-charged,
   :to :state/cancelled-charged-paid}
  {:name :transition/review-1-by-provider,
   :actor :actor.role/provider,
   :actions [{:name :action/post-review-by-provider}],
   :from :state/delivered,
   :to :state/reviewed-by-provider}
  {:name :transition/review-2-by-provider,
   :actor :actor.role/provider,
   :actions
   [{:name :action/post-review-by-provider}
    {:name :action/publish-reviews}],
   :from :state/reviewed-by-customer,
   :to :state/reviewed}
  {:name :transition/review-1-by-customer,
   :actor :actor.role/customer,
   :actions [{:name :action/post-review-by-customer}],
   :from :state/delivered,
   :to :state/reviewed-by-customer}
  {:name :transition/review-2-by-customer,
   :actor :actor.role/customer,
   :actions
   [{:name :action/post-review-by-customer}
    {:name :action/publish-reviews}],
   :from :state/reviewed-by-provider,
   :to :state/reviewed}
  {:name :transition/expire-review-period,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/booking-end]} {:fn/period ["P7D"]}]},
   :actions [],
   :from :state/delivered,
   :to :state/reviewed}
  {:name :transition/expire-provider-review-period,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/booking-end]} {:fn/period ["P7D"]}]},
   :actions [{:name :action/publish-reviews}],
   :from :state/reviewed-by-customer,
   :to :state/reviewed}
  {:name :transition/expire-customer-review-period,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/booking-end]} {:fn/period ["P7D"]}]},
   :actions [{:name :action/publish-reviews}],
   :from :state/reviewed-by-provider,
   :to :state/reviewed}],
 :notifications
 [{:name :notification/booking-new-request,
   :on :transition/confirm-payment,
   :to :actor.role/provider,
   :template :booking-new-request}
  {:name :notification/booking-accepted-request,
   :on :transition/accept,
   :to :actor.role/customer,
   :template :booking-accepted-request}
  {:name :notification/booking-operator-accepted-request-to-customer,
   :on :transition/operator-accept,
   :to :actor.role/customer,
   :template :booking-accepted-request}
  {:name :notification/booking-operator-accepted-request-to-provider,
   :on :transition/operator-accept,
   :to :actor.role/provider,
   :template :booking-operator-accepted-request}
  {:name :notification/booking-declined-request,
   :on :transition/decline,
   :to :actor.role/customer,
   :template :booking-declined-request}
  {:name :notification/booking-operator-declined-request-to-customer,
   :on :transition/operator-decline,
   :to :actor.role/customer,
   :template :booking-declined-request}
  {:name :notification/booking-operator-declined-request-to-provider,
   :on :transition/operator-decline,
   :to :actor.role/provider,
   :template :booking-operator-declined-request}
  {:name :notification/booking-expired-request,
   :on :transition/expire,
   :to :actor.role/customer,
   :template :booking-expired-request}
  {:name :notification/booking-money-paid,
   :on :transition/auto-payout,
   :to :actor.role/provider,
   :template :booking-money-paid}
  {:name :notification/review-period-start-provider,
   :on :transition/auto-payout,
   :to :actor.role/provider,
   :template :booking-review-by-provider-wanted}
  {:name :notification/review-period-start-customer,
   :on :transition/auto-payout,
   :to :actor.role/customer,
   :template :booking-review-by-customer-wanted}
  {:name :notification/booking-money-paid-operator-complete,
   :on :transition/operator-complete,
   :to :actor.role/provider,
   :template :booking-money-paid}
  {:name :notification/review-by-provider-first,
   :on :transition/review-1-by-provider,
   :to :actor.role/customer,
   :template :booking-review-by-other-party-unpublished}
  {:name :notification/review-by-customer-first,
   :on :transition/review-1-by-customer,
   :to :actor.role/provider,
   :template :booking-review-by-other-party-unpublished}
  {:name :notification/review-by-provider-second,
   :on :transition/review-2-by-provider,
   :to :actor.role/customer,
   :template :booking-review-by-other-party-published}
  {:name :notification/review-by-customer-second,
   :on :transition/review-2-by-customer,
   :to :actor.role/provider,
   :template :booking-review-by-other-party-published}
  ;; --- Cancellations (both parties; no reason ever referenced) ---
  ;; Full-refund cancels: client fully refunded, provider not paid.
  {:name :notification/customer-cancel-to-customer,
   :on :transition/customer-cancel,
   :to :actor.role/customer,
   :template :booking-cancelled-customer}
  {:name :notification/customer-cancel-to-provider,
   :on :transition/customer-cancel,
   :to :actor.role/provider,
   :template :booking-cancelled-provider}
  ;; No-refund cancel (customer cancelled <48h): client charged, provider still paid.
  {:name :notification/customer-cancel-late-to-customer,
   :on :transition/customer-cancel-late,
   :to :actor.role/customer,
   :template :booking-cancelled-charged-customer}
  {:name :notification/customer-cancel-late-to-provider,
   :on :transition/customer-cancel-late,
   :to :actor.role/provider,
   :template :booking-cancelled-charged-provider}
  {:name :notification/provider-cancel-to-customer,
   :on :transition/provider-cancel,
   :to :actor.role/customer,
   :template :booking-cancelled-customer}
  {:name :notification/provider-cancel-to-provider,
   :on :transition/provider-cancel,
   :to :actor.role/provider,
   :template :booking-cancelled-provider}
  {:name :notification/provider-cancel-late-to-customer,
   :on :transition/provider-cancel-late,
   :to :actor.role/customer,
   :template :booking-cancelled-customer}
  {:name :notification/provider-cancel-late-to-provider,
   :on :transition/provider-cancel-late,
   :to :actor.role/provider,
   :template :booking-cancelled-provider}
  {:name :notification/operator-cancel-to-customer,
   :on :transition/operator-cancel,
   :to :actor.role/customer,
   :template :booking-cancelled-customer}
  {:name :notification/operator-cancel-to-provider,
   :on :transition/operator-cancel,
   :to :actor.role/provider,
   :template :booking-cancelled-provider}
  {:name :notification/operator-cancel-late-to-customer,
   :on :transition/operator-cancel-late,
   :to :actor.role/customer,
   :template :booking-cancelled-customer}
  {:name :notification/operator-cancel-late-to-provider,
   :on :transition/operator-cancel-late,
   :to :actor.role/provider,
   :template :booking-cancelled-provider}
  ;; Operator refunds a no-refund cancel (reverses the charge): client refunded, provider not paid.
  {:name :notification/operator-cancel-charged-to-customer,
   :on :transition/operator-cancel-charged,
   :to :actor.role/customer,
   :template :booking-refunded-dispute-customer}
  {:name :notification/operator-cancel-charged-to-provider,
   :on :transition/operator-cancel-charged,
   :to :actor.role/provider,
   :template :booking-refunded-dispute-provider}
  ;; --- Dispute raised by the customer (payout paused) ---
  {:name :notification/dispute-to-customer,
   :on :transition/dispute,
   :to :actor.role/customer,
   :template :booking-dispute-customer}
  {:name :notification/dispute-to-provider,
   :on :transition/dispute,
   :to :actor.role/provider,
   :template :booking-dispute-provider}
  ;; Operator pauses payout to investigate.
  {:name :notification/operator-dispute-hold-to-provider,
   :on :transition/operator-dispute-hold,
   :to :actor.role/provider,
   :template :booking-dispute-provider}
  ;; --- Dispute resolutions ---
  ;; Refund the client (from completed or from hold): client refunded, provider not paid.
  {:name :notification/operator-dispute-refund-to-customer,
   :on :transition/operator-dispute-refund,
   :to :actor.role/customer,
   :template :booking-refunded-dispute-customer}
  {:name :notification/operator-dispute-refund-to-provider,
   :on :transition/operator-dispute-refund,
   :to :actor.role/provider,
   :template :booking-refunded-dispute-provider}
  {:name :notification/operator-hold-refund-to-customer,
   :on :transition/operator-hold-refund,
   :to :actor.role/customer,
   :template :booking-refunded-dispute-customer}
  {:name :notification/operator-hold-refund-to-provider,
   :on :transition/operator-hold-refund,
   :to :actor.role/provider,
   :template :booking-refunded-dispute-provider}
  ;; Release the held payout: provider paid (reuses the money-paid breakdown template).
  {:name :notification/operator-hold-release-to-provider,
   :on :transition/operator-hold-release,
   :to :actor.role/provider,
   :template :booking-money-paid}
  ;; --- Backstop payout after a no-refund cancel: provider paid ---
  {:name :notification/payout-cancelled-charged-to-provider,
   :on :transition/payout-cancelled-charged,
   :to :actor.role/provider,
   :template :booking-money-paid}]}
